generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
}

enum OrderStatus {
  PENDING
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model Transaction {
  id String @id @default(cuid())

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  authority String  @unique
  refId     String?

  amount Int

  status TransactionStatus @default(PENDING)

  gateway String @default("ZARINPAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LogAction {
  CREATE_PRODUCT
  UPDATE_PRODUCT
  DELETE_PRODUCT
  UPDATE_STOCK
  CREATE_ORDER
  UPDATE_ORDER_STATUS
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  SEND_OTP
  VERIFY_OTP
  BLOCK_USER
  UNBLOCK_USER

  LOGIN
  LOGOUT

  CREATE_TASK
  UPDATE_TASK
  DELETE_TASK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ShippingMethod {
  POST
  SNAPPBOX
  TIPAX
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean   @default(false)

  @@index([phone])
}

model User {
  id              String  @id @default(cuid())
  name            String
  phone           String  @unique
  email           String?
  password        String
  role            Role    @default(CUSTOMER)
  isPhoneVerified Boolean @default(false)
  phoneVerifiedAt DateTime?
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishlist      WishlistItem[]
  orders        Order[]
  cart          CartItem[]
  auditLogs     AuditLog[]
  reviews       Review[]
  sentTasks     Task[]         @relation("TaskFrom")
  receivedTasks Task[]         @relation("TaskTo")
  addresses     Address[]
}

model Address {
  id     String @id @default(cuid())
  userId String

  receiverName  String
  receiverPhone String

  provinceId   Int
  provinceName String

  cityId   Int
  cityName String

  address    String
  postalCode String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Category {
  id    Int    @id @default(autoincrement())
  title String @unique
  slug  String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Brand {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Tag {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  slug      String   @unique
  updatedAt DateTime @updatedAt

  products ProductTag[]
}

model ProductTag {
  productId Int
  tagId     Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Product {
  id            Int          @id @default(autoincrement())
  title         String
  categoryId    Int
  price         Int
  originalPrice Int
  discount      Int          @default(0)
  category      Category     @relation(fields: [categoryId], references: [id])
  image         String
  description   String
  stock         Int          @default(0)
  rating        Float        @default(0)
  reviewCount   Int          @default(0)
  createdAt     DateTime     @default(now())
  brandId       Int?
  brand         Brand?       @relation(fields: [brandId], references: [id])
  tags          ProductTag[]
  isPublished   Boolean      @default(true)
  slug          String?      @unique

  wishlistItems WishlistItem[]
  images        ProductImage[]
  specs         ProductSpec[]
  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  url       String
  productId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpec {
  id        Int    @id @default(autoincrement())
  key       String
  value     String
  productId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        Int      @id @default(autoincrement())
  user      String
  userId    String?
  rating    Int
  comment   String
  date      String
  approved  Boolean  @default(false)
  productId Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CartItem {
  id        Int    @id @default(autoincrement())
  quantity  Int    @default(1)
  userId    String
  productId Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id Int @id @default(autoincrement())

  userId String
  user User @relation(fields: [userId], references: [id])

  total Int

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  authority String? @unique
  paymentExpiresAt DateTime?
  refId String?
  paidAt DateTime?

  // اطلاعات گیرنده
  receiverName String
  receiverPhone String

  provinceId Int
  provinceName String

  cityId Int
  cityName String

  address String
  postalCode String

  // اطلاعات ارسال
  shippingMethod ShippingMethod?
  shippingCost Int @default(0)

  trackingCode String?
  shippedAt DateTime?
  deliveredAt DateTime?

  items OrderItem[]

  transaction Transaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model AuditLog {
  id          String    @id @default(cuid())
  action      LogAction
  entityType  String
  entityId    String
  description String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  priority    Priority @default(MEDIUM)
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())

  fromId String
  toId   String

  from User @relation("TaskFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("TaskTo", fields: [toId], references: [id], onDelete: Cascade)
}
