DATABASE_URL="postgresql://postgres:YOUR_LOCAL_DB_PASSWORD@localhost:5432/myshop"

JWT_SECRET="YOUR_NEW_LOCAL_JWT_SECRET"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

ZARINPAL_MERCHANT_ID="YOUR_ZARINPAL_MERCHANT_ID"
ZARINPAL_SANDBOX=true

SMS_IR_API_KEY="YOUR_SMS_IR_API_KEY"
SMS_IR_VERIFY_TEMPLATE_ID="642356"
# Optional dedicated template for risk-based login OTP; falls back to VERIFY template.
SMS_IR_LOGIN_TEMPLATE_ID=
SMS_IR_RESET_PASSWORD_TEMPLATE_ID="104448"

# ── Added by security remediation (placeholders only — never commit real values) ──
# Secret for POST /api/internal/cron (reservation expiry/reconciliation + cleanup). >= 32 random chars.
CRON_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Optional separate pepper for OTP hashing (falls back to JWT_SECRET). Changing it invalidates pending OTPs only.
OTP_PEPPER=
# Cloudflare Turnstile (used after repeated failed login passwords).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
# Grace after the 15-minute reservation expires before the job verifies/releases it (seconds).
RESERVATION_RELEASE_GRACE_SECONDS=120
# AI assistant budgets (DB-backed, cross-process)
AI_IP_HOURLY_LIMIT=40
AI_GLOBAL_DAILY_LIMIT=3000
# NEVER set ZARINPAL_SANDBOX=true in production (payment/request refuses to run). Do not set the override below.
# ALLOW_ZARINPAL_SANDBOX_IN_PRODUCTION=false

