generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  SUPPLIER
}

enum OrderStatus {
  PENDING
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum FulfillmentStatus {
  PREPARING
  READY_FOR_HANDOVER
  HANDED_TO_CARRIER
  SHIPPED
  DELIVERED
  ISSUE
}

enum ProductReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum StockReservationStatus {
  NONE
  RESERVED
  CONSUMED
  RELEASED
  ISSUE
}

model Transaction {
  id String @id @default(cuid())

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  authority String  @unique
  refId     String?

  amount Int

  status TransactionStatus @default(PENDING)

  gateway String @default("ZARINPAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LogAction {
  CREATE_PRODUCT
  UPDATE_PRODUCT
  DELETE_PRODUCT
  UPDATE_STOCK
  CREATE_ORDER
  UPDATE_ORDER_STATUS
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  SEND_OTP
  VERIFY_OTP
  BLOCK_USER
  UNBLOCK_USER

  LOGIN
  LOGOUT

  CREATE_TASK
  UPDATE_TASK
  DELETE_TASK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ShippingMethod {
  POST
  SNAPPBOX
  TIPAX
}

enum OtpPurpose {
  VERIFY_PHONE
  RESET_PASSWORD
  LOGIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model OtpCode {
  id             String     @id @default(cuid())
  phone          String
  code           String
  purpose        OtpPurpose
  expiresAt      DateTime
  createdAt      DateTime   @default(now())
  used           Boolean    @default(false)
  failedAttempts Int        @default(0)

  @@index([phone, purpose])
  @@index([expiresAt])
}

model User {
  id                String    @id @default(cuid())
  name              String
  phone             String    @unique
  email             String?
  password          String
  role              Role      @default(CUSTOMER)
  isPhoneVerified   Boolean   @default(false)
  phoneVerifiedAt   DateTime?
  isActive          Boolean   @default(true)
  tokenVersion      Int       @default(0)
  passwordChangedAt DateTime?
  address           String?
  postalCode        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishlist           WishlistItem[]
  orders             Order[]
  cart               CartItem[]
  auditLogs          AuditLog[]
  reviews            Review[]
  sentTasks          Task[]             @relation("TaskFrom")
  receivedTasks      Task[]             @relation("TaskTo")
  addresses          Address[]
  suppliedProducts   Product[]          @relation("ProductSupplier")
  sellerOrderItems   OrderItem[]        @relation("OrderItemSupplier")
  sellerFulfillments OrderFulfillment[] @relation("SupplierFulfillments")
}

model Address {
  id     String @id @default(cuid())
  userId String

  receiverName  String
  receiverPhone String

  provinceId   Int
  provinceName String

  cityId   Int
  cityName String

  address    String
  postalCode String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Category {
  id    Int    @id @default(autoincrement())
  title String @unique
  slug  String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Brand {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Tag {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  slug      String   @unique
  updatedAt DateTime @updatedAt

  products ProductTag[]
}

model ProductTag {
  productId Int
  tagId     Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Product {
  id            Int                 @id @default(autoincrement())
  title         String
  categoryId    Int
  price         Int
  originalPrice Int
  discount      Int                 @default(0)
  category      Category            @relation(fields: [categoryId], references: [id])
  image         String
  description   String
  stock         Int                 @default(0)
  rating        Float               @default(0)
  reviewCount   Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  brandId       Int?
  brand         Brand?              @relation(fields: [brandId], references: [id])
  tags          ProductTag[]
  isPublished   Boolean             @default(true)
  reviewStatus  ProductReviewStatus @default(APPROVED)
  reviewNote    String?
  slug          String?             @unique
  reservedStock Int                 @default(0)

  // Internal owner. NULL = Borjak-owned (admin-created / legacy). Never exposed publicly.
  supplierId String?
  supplier   User?   @relation("ProductSupplier", fields: [supplierId], references: [id], onDelete: Restrict)

  // Soft delete / Archive
  deletedAt DateTime?

  wishlistItems WishlistItem[]
  images        ProductImage[]
  specs         ProductSpec[]
  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([deletedAt])
  @@index([isPublished, deletedAt])
  @@index([supplierId, deletedAt])
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  url       String
  productId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpec {
  id        Int    @id @default(autoincrement())
  key       String
  value     String
  productId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        Int      @id @default(autoincrement())
  user      String
  userId    String?
  rating    Int
  comment   String
  date      String
  approved  Boolean  @default(false)
  productId Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, approved])
}

model CartItem {
  id        Int    @id @default(autoincrement())
  quantity  Int    @default(1)
  userId    String
  productId Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id Int @id @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  total Int

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)
  requiresPrintedInvoice Boolean @default(false)

  stockReservationStatus StockReservationStatus @default(NONE)
  stockIssueAt           DateTime?

  authority        String?   @unique
  paymentExpiresAt DateTime?
  refId            String?
  paidAt           DateTime?

  // اطلاعات گیرنده
  receiverName  String
  receiverPhone String

  provinceId   Int
  provinceName String

  cityId   Int
  cityName String

  address    String
  postalCode String

  // Legacy order-level shipping fields retained for backwards compatibility.
  // New multi-seller shipment data is stored in OrderFulfillment.
  shippingMethod ShippingMethod?
  shippingCost   Int             @default(0)
  trackingCode   String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  items        OrderItem[]
  fulfillments OrderFulfillment[]

  transaction Transaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockRestockedAt DateTime?

  @@index([stockReservationStatus, paymentExpiresAt])
  @@index([userId, paymentStatus, status])
  @@index([paymentStatus, status])
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Int

  // Snapshot of the seller who owned the product when this order item was created.
  // NULL + supplierSnapshotCaptured=true means Borjak-owned.
  // Existing rows remain false until their historical ownership is explicitly resolved.
  supplierId               String?
  supplierSnapshotCaptured Boolean @default(false)

  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id])
  supplier User?   @relation("OrderItemSupplier", fields: [supplierId], references: [id], onDelete: Restrict)

  fulfillmentItems FulfillmentItem[]

  @@index([orderId])
  @@index([productId])
  @@index([supplierId])
  @@index([supplierSnapshotCaptured])
}

// One fulfillment per seller (including Borjak itself) within a customer order.
// sellerKey is "SUPPLIER:<userId>" or "BORJAK" for Borjak-owned items.
model OrderFulfillment {
  id                  String            @id @default(cuid())
  orderId             Int
  supplierId          String?
  sellerKey           String
  status              FulfillmentStatus @default(PREPARING)
  shippingMethod      ShippingMethod?
  shippingCost        Int               @default(0)
  handedOverAt        DateTime?
  trackingCode        String?
  trackingCodeAddedAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  issueNote           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  supplier User?             @relation("SupplierFulfillments", fields: [supplierId], references: [id], onDelete: Restrict)
  items    FulfillmentItem[]

  @@unique([orderId, sellerKey])
  @@index([supplierId, status, createdAt])
  @@index([orderId, status])
  @@index([trackingCode])
}

// Connects the original order lines to the seller-specific parcel.
model FulfillmentItem {
  id            Int    @id @default(autoincrement())
  fulfillmentId String
  orderItemId   Int    @unique
  quantity      Int

  fulfillment OrderFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([fulfillmentId])
}

model AuditLog {
  id          String    @id @default(cuid())
  action      LogAction
  entityType  String
  entityId    String
  description String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  userId      String?
  userLabel   String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  priority Priority   @default(MEDIUM)
  status   TaskStatus @default(TODO)

  // برای سازگاری با کدهای قدیمی حفظ شده است.
  // در APIها با status هماهنگ نگه داشته می‌شود.
  done Boolean @default(false)

  dueAt            DateTime?
  supplierResponse String?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  fromId String
  toId   String

  from User @relation("TaskFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("TaskTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId, status, dueAt])
  @@index([fromId, createdAt])
}

model LoginAttempt {
  phoneKey        String    @id
  failedAttempts  Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

// History of every payment authority issued (survives order/transaction changes).
model PaymentAttempt {
  id        String   @id @default(cuid())
  orderId   Int
  userId    String?
  authority String   @unique
  amount    Int
  gateway   String   @default("ZARINPAL")
  status    String   @default("PENDING") // PENDING | PAID | FAILED | EXPIRED | REVIEW
  refId     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}
